---
import BaseHead from "@shared/ui/BaseHead/BaseHead.astro";
import ThemeIcon from "@features/theme-toggle/ui/ThemeIcon.astro";

const pathName = Astro.url.pathname;
---

<html lang="en">
  <head>
    {
      pathName === "/"
        ? <BaseHead />
        : <BaseHead title={pathName.charAt(1).toUpperCase() + pathName.slice(2).split("/")[0]} />
    }
  </head>
  <body>
    <ThemeIcon />
    <main>
      <slot />
    </main>
  </body>
</html>
