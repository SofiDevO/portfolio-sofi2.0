---
import Title from "@shared/ui/Title/Title";
import ButtonAbout from "@entities/user/ui/ButtonAbout.astro";
import Calendar from "@entities/github/ui/Calendar";
import AboutData from "@entities/user/content/about.mdx";

export const prerender = true;
const { data } = Astro.props;
---

<section class="about" id="about">
  <article class="about__container">
    <div class="about__profile">
      <div class="profile__box">
        <img
          src={data.aboutPicture}
          alt={`Foto de perfil de ${data.name} ${data.lastName}`}
          class="profile__box__image"
          width="100"
          height="100"
        />
      </div>
      <ButtonAbout typeMail="true" data={data.email} link={data.email} text="email" clase="email" />
      <ButtonAbout link={data.cv} text="Download cv" clase="cv" />
    </div>
    <div class="about__content">
      <Title titleDesc="About Me" clase="title-dark" />
      <AboutData />
    </div>
  </article>
  <Calendar client:only="react" />
</section>
