---
import Title from "@shared/ui/Title/Title";
import ButtonAbout from "@entities/user/ui/ButtonAbout.astro";
import Calendar from "@entities/github/ui/Calendar";
import { AboutData } from "@types/index";
import AboutMDX from "src/entities/user/content/about.mdx";
const { data } = Astro.props;
---

<section class="about" id="about">
  <article class="about__container">
    <div class="about__profile">
      <div class="profile__box">
        <img
          src={data.profilePicture}
          alt={data.profilePictureAlt}
          class="profile__box__image"
          width="100"
          height="100"
        />
      </div>
      <ButtonAbout
        typeMail="true"
        data={data.email}
        link={data.email}
        text="email"
        clase="email"
      />
      <ButtonAbout link={data.cvURL} text="Download cv" clase="cv" />
    </div>
    <div class="about__content">
      <Title titleDesc="About Me " clase="title-dark" tag="h2" />

      <Title titleDesc={data.name} clase="title-dark" tag="h3" />

      {
        data.content ? (
          <div class="about__content" set:html={data.content} />
        ) : (
          <AboutMDX />
        )
      }
    </div>
  </article>
  <div class="about__experience">
    <Title titleDesc="Job Experience" clase="title-dark " tag="h3" />
    <div class="about__experience__content" set:html={data.experienciLaboral} />
  </div>
  <div class="about__calendar">
    <Title
      titleDesc="My Github contributions"
      clase="title-dark about__calendar-title"
      tag="h3"
    />
    <Calendar client:only="react" />
  </div>
</section>
