---
const { clase } = Astro.props;
---

<div class={`caja__terminal ${clase}`}>
  <!-- Terminal bar decoration -->
  <div class="barra__terminal">
    <span class="btn__red"></span>
    <span class="btn__yellow"></span>
    <span class="btn__green"></span>
  </div>
  <div class="caja__cristal caja__dark">
    <slot />
  </div>
</div>
