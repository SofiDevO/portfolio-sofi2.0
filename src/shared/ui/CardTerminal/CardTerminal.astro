---
const { clase } = Astro.props;
---

<div class={`caja__terminal ${clase}`}>
  <!-- Terminal bar decoration -->
  <div class="terminal_toolbar">
    <span class="btn btn__red"></span>
    <span class="btn btn__yellow"></span>
    <span class="btn btn__green"></span>
  </div>
  <div class="caja__cristal caja__dark">
    <slot />
  </div>
</div>
