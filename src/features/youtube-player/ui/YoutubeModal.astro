---
import { fetchLatestYouTubeVideo } from "@entities/youtube/api/youtube";

let videoData;
try {
  videoData = await fetchLatestYouTubeVideo();
} catch (error) {
  videoData = null;
}
const fallbackVideoId = "bNFQxl92zu8";
const fallbackThumbnail = `https://img.youtube.com/vi/${fallbackVideoId}/hqdefault.jpg`;

const {
  id: videoId = fallbackVideoId,
  thumbnail = fallbackThumbnail,
  title = "Astro Tema Oscuro Tutorial",
} = videoData || {};
---

<script>
  import "@features/youtube-player/model/fastYoutube.ts";
  import { loadVideo } from "@features/youtube-player/model/videoModal.js";
  loadVideo();
</script>

{
  (
    <section class="youtube__modal__box">
      <div class="youtube__close__button"></div>
      <div class="youtube__modal__container">
        <fast-youtube id={videoId} title={title}></fast-youtube>
      </div>
    </section>
  )
}
<style is:inline>
  lite-youtube {
    min-width: 100%;
    height: 100%;
  }
</style>

<style lang="scss">
  .youtube__modal__box {
    position: fixed;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 1200;
  }
  .youtube__close__button {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.699);
    cursor: pointer;
  }
  .youtube__modal__container {
    position: absolute;
    width: 95%;
    max-width: 900px;
    height: 550px;
    overflow: hidden;
    border-radius: 12px;
    border: solid 2px #1d536e;
  }
  @media (max-width: 900px) {
    .youtube__modal__container {
      height: 500px;
    }
  }
  @media (max-width: 600px) {
    .youtube__modal__container {
      height: 400px;
    }
  }
  @media (max-width: 400px) {
    .youtube__modal__container {
      height: 350px;
    }
  }
</style>
