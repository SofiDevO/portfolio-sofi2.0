---
import Carousel from "@shared/ui/Carousel/Carousel.astro";
const { skillsData } = Astro.props;
---

<Carousel class="slide__track--skills" style={`--icons-length: ${skillsData.length};`}>
  {[...skillsData, ...skillsData].map((data) => (
    <div class="slide">
      <div class="tag">{data.name}</div>
      <iconify-icon icon={data.icon} width="40" height="40" />
    </div>
  ))}
</Carousel>