---
import Carousel from "@shared/ui/Carousel/Carousel.astro";
const { toolsData } = Astro.props;
---

<Carousel class="slide__track--tools" style={`--tools-length: ${toolsData.length};`}>
  {[...toolsData, ...toolsData, ...toolsData].map((data) => (
    <div class="slide">
      <div class="tag">{data.name}</div>
      <iconify-icon icon={data.icon} width="40" height="40" />
    </div>
  ))}
</Carousel>