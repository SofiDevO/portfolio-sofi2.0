---
import BackgroundGradient from "@app/layouts/BackgroundGradient/BackgroundGradient.astro";
import Layout from "@app/layouts/Layout.astro";
import Hero from "@widgets/hero/ui/Hero.astro";
import DividerBottom from "@shared/ui/Divider/DividerBottom.astro";
import About from "@widgets/about/ui/About.astro";
import DividerTop from "@shared/ui/Divider/DividerTop.astro";
import Skills from "@widgets/skills/ui/Skills.astro";
import Portfolio from "@widgets/portfolio/ui/Portfolio.astro";
import Social from "@widgets/social/ui/Social.astro";
import Footer from "@widgets/footer/ui/Footer.astro";
import ToastNotification from "@shared/ui/ToastNotification/ToastNotification.astro";
import { getData } from "@entities/user/api/getData";
import { getAboutData } from "@entities/user/api/getAboutData";

const { user, skills, tools } = await getData();

const aboutData = await getAboutData();
const avatar = aboutData?.featuredImage.mediaItemUrl;
console.log("Portfolio about data: ",aboutData);
export const prerender = true;
---

<Layout>
  <BackgroundGradient>
    <Hero data={user} avatar={avatar} />
  </BackgroundGradient>
  <DividerTop />
  <About data={aboutData} />
  <DividerBottom fill="shape-fill-3" />
  <Skills data={user} skills={skills} tools={tools} />
  <DividerTop fill="shape-fill-purple " />
  <Portfolio cardsLength={3} server:defer />
  <DividerBottom fill="shape-fill-3" />
  <Social server:defer />
  <Footer />
</Layout>
<ToastNotification />
<script>
  import ToastNotification from "@features/contact-form/model/toastAlerts.js";
  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(() => {
      ToastNotification("This site is under construction 🚧🏗️", "info");
    }, 4000);
  });
</script>
