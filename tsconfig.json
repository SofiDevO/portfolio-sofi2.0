{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "module": "es2020",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@app/*":      ["src/app/*"],
      "@widgets/*":  ["src/widgets/*"],
      "@features/*": ["src/features/*"],
      "@entities/*": ["src/entities/*"],
      "@shared/*":   ["src/shared/*"],
      "@types/*":    ["src/types/*"],
      "@pages/*":    ["src/pages/*"]
    },
    "moduleResolution": "node"
  }
}
